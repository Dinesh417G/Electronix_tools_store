  "query": "\n        select m.id as \"id!\", m.code as \"code!\", m.name, m.active as \"active!\",\n               (select count(*) from stock_ledger l where l.machine_id = m.id)\n                 as \"txn_count!\"\n          from machines m\n         order by m.active desc, m.code\n        ",
