  "query": "\n        select l.id, l.item_id, l.delta_qty, l.created_at,\n               s.on_hand as \"on_hand!\", s.alert_state as \"alert_state!\"\n          from stock_ledger l\n          join item_stock s on s.item_id = l.item_id\n         where l.client_txn_uuid = $1\n        ",
